// Hospital Management System — Prisma schema
//
// Conventions:
//   * models are PascalCase singular, fields camelCase
//   * every table carries createdAt; mutable tables also carry updatedAt
//   * every foreign key is indexed
//   * money is Decimal(12, 2) — never Float
//
// This schema is ADDITIVE with respect to the original five tables
// (User, Patient, Doctor, Appointment, MedicalRecord). No existing column is
// dropped or retyped, so the accompanying migration preserves existing rows.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────── Enums ────────────────────────────────

enum Role {
  PATIENT
  DOCTOR
  STAFF
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PrescriptionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  MOBILE_MONEY
  INSURANCE
}

enum NotificationType {
  APPOINTMENT
  PRESCRIPTION
  BILLING
  MESSAGE
  SYSTEM
}

// ──────────────────────────────── Identity ────────────────────────────────

model User {
  id        Int      @id @default(autoincrement())
  name      String?
  email     String   @unique
  password  String
  role      Role     @default(PATIENT)
  createdAt DateTime @default(now())

  // Retained from the original schema. These are non-null with "" defaults;
  // kept as-is so no existing row is invalidated.
  phone   String @default("")
  address String @default("")
  age     String @default("")
  gender  String @default("")

  updatedAt   DateTime  @updatedAt @default(now())
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?

  patient Patient?
  doctor  Doctor?

  notifications       Notification[]
  conversationsJoined ConversationParticipant[]
  messagesSent        Message[]
  auditLogs           AuditLog[]
  paymentsRecorded    Payment[]
  attachmentsUploaded Attachment[]

  @@index([role])
  @@index([createdAt])
}

// ──────────────────────────────── Org ────────────────────────────────

model Department {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())

  doctors Doctor[]
}

/// Single-row table (id is always 1) holding tenant-configurable branding and
/// contact details used on printed documents.
model HospitalSettings {
  id             Int      @id @default(1)
  name           String   @default("Hospital Management System")
  addressLine    String   @default("")
  phone          String   @default("")
  email          String   @default("")
  website        String   @default("")
  logoUrl        String?
  currency       String   @default("ETB")
  timezone       String   @default("Africa/Addis_Ababa")
  emergencyPhone String   @default("")
  updatedAt      DateTime @updatedAt @default(now())
}

// ──────────────────────────────── Clinical actors ────────────────────────────────

model Patient {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Human-facing identifier printed on documents, e.g. "P-000042".
  mrn String? @unique

  dateOfBirth DateTime?
  bloodType   String?
  allergies   String?
  /// Free-text prior history captured at registration.
  history     String?

  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  medicalRecords MedicalRecord[]
  appointments   Appointment[]
  prescriptions  Prescription[]
  invoices       Invoice[]
  attachments    Attachment[]
}

model Doctor {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  specialization String

  departmentId    Int?
  department      Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  licenseNumber   String?     @unique
  bio             String?
  yearsExperience Int?
  consultationFee Decimal?    @db.Decimal(12, 2)
  isAcceptingNew  Boolean     @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  appointments   Appointment[]
  availability   DoctorAvailability[]
  medicalRecords MedicalRecord[]
  prescriptions  Prescription[]

  @@index([departmentId])
  @@index([specialization])
}

/// A recurring weekly working window. Bookable slots are derived from these
/// rows at request time; slots are not materialised in the database.
model DoctorAvailability {
  id       Int    @id @default(autoincrement())
  doctorId Int
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  /// 0 = Sunday … 6 = Saturday, matching JavaScript's Date#getDay().
  dayOfWeek   Int
  /// Local wall-clock time in 24h "HH:mm" form.
  startTime   String
  endTime     String
  slotMinutes Int     @default(30)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  @@unique([doctorId, dayOfWeek, startTime])
  @@index([doctorId])
}

// ──────────────────────────────── Scheduling ────────────────────────────────

model Appointment {
  id         Int               @id @default(autoincrement())
  date       DateTime
  reason     String
  department String
  status     AppointmentStatus @default(PENDING)
  patientId  Int
  doctorId   Int?
  patient    Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor     Doctor?           @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  createdAt  DateTime          @default(now())

  durationMinutes Int       @default(30)
  notes           String?
  cancelledAt     DateTime?
  cancelReason    String?
  updatedAt       DateTime  @updatedAt @default(now())

  medicalRecords MedicalRecord[]
  prescriptions  Prescription[]
  invoices       Invoice[]

  /// Hard guard against double-booking. Postgres treats NULLs as distinct, so
  /// unassigned (doctorId = null) appointments are unaffected.
  @@unique([doctorId, date], name: "doctor_slot_unique")
  @@index([patientId])
  @@index([doctorId])
  @@index([date])
  @@index([status])
}

// ──────────────────────────────── Clinical records ────────────────────────────────

model MedicalRecord {
  id        Int      @id @default(autoincrement())
  /// Original free-text column, retained. New writes should prefer the
  /// structured fields below and leave this as a short summary.
  details   String
  createdAt DateTime @default(now())
  patientId Int
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  doctorId      Int?
  doctor        Doctor?      @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  appointmentId Int?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  visitDate DateTime @default(now())
  diagnosis String?
  symptoms  String?
  treatment String?
  notes     String?

  updatedAt DateTime @updatedAt @default(now())

  prescriptions Prescription[]

  @@index([patientId])
  @@index([doctorId])
  @@index([appointmentId])
  @@index([visitDate])
}

model Prescription {
  id        Int                @id @default(autoincrement())
  patientId Int
  patient   Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId  Int
  doctor    Doctor             @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  status    PrescriptionStatus @default(ACTIVE)

  medicalRecordId Int?
  medicalRecord   MedicalRecord? @relation(fields: [medicalRecordId], references: [id], onDelete: SetNull)
  appointmentId   Int?
  appointment     Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  issuedAt DateTime @default(now())
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  items PrescriptionItem[]

  @@index([patientId])
  @@index([doctorId])
  @@index([medicalRecordId])
  @@index([issuedAt])
}

model PrescriptionItem {
  id             Int          @id @default(autoincrement())
  prescriptionId Int
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  medication   String
  dosage       String
  frequency    String
  durationDays Int?
  instructions String?

  createdAt DateTime @default(now())

  @@index([prescriptionId])
}

// ──────────────────────────────── Billing ────────────────────────────────

model Invoice {
  id     Int           @id @default(autoincrement())
  /// Sequential human-readable number, e.g. "INV-2026-000031".
  number String        @unique
  status InvoiceStatus @default(DRAFT)

  patientId     Int
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointmentId Int?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  issuedAt DateTime  @default(now())
  dueAt    DateTime?
  notes    String?

  subtotal Decimal @default(0) @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  items    InvoiceItem[]
  payments Payment[]

  @@index([patientId])
  @@index([status])
  @@index([issuedAt])
}

model InvoiceItem {
  id        Int     @id @default(autoincrement())
  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

/// A payment recorded by staff against an invoice. This is a ledger entry only —
/// the application does not process payments and integrates with no gateway.
model Payment {
  id        Int     @id @default(autoincrement())
  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod @default(CASH)
  reference String?
  paidAt    DateTime      @default(now())

  recordedById Int?
  recordedBy   User? @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([paidAt])
}

// ──────────────────────────────── Notifications ────────────────────────────────

model Notification {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   NotificationType @default(SYSTEM)
  title  String
  body   String?
  /// In-app href the notification points at, e.g. "/dashboard/appointments/12".
  link   String?
  isRead Boolean          @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

// ──────────────────────────────── Messaging ────────────────────────────────

model Conversation {
  id        Int      @id @default(autoincrement())
  subject   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  participants ConversationParticipant[]
  messages     Message[]

  @@index([updatedAt])
}

model ConversationParticipant {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  lastReadAt DateTime?
  joinedAt   DateTime  @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       Int
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  body      String
  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
}

// ──────────────────────────────── Audit ────────────────────────────────

/// Append-only record of privileged actions. Deliberately stores only the actor,
/// the verb, and the identity of the affected row — never clinical content.
model AuditLog {
  id      Int   @id @default(autoincrement())
  actorId Int?
  actor   User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  action   String
  entity   String
  entityId String?
  summary  String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ──────────────────────────────── Documents ────────────────────────────────

/// A file attached to a patient's chart — a scanned referral, a lab PDF, an
/// imaging report. The bytes live on disk (or object storage, if configured);
/// this row is the metadata and access-control anchor. See lib/storage.ts.
model Attachment {
  id        Int     @id @default(autoincrement())
  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  uploadedById Int?
  uploadedBy   User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  filename    String
  mimeType    String
  sizeBytes   Int
  /// Opaque key into storage — never a client-supplied path. See
  /// lib/storage.ts for the naming scheme and its path-traversal guard.
  storageKey  String   @unique
  description String?

  createdAt DateTime @default(now())

  @@index([patientId])
  @@index([createdAt])
}
