# Copy to .env and fill in. Never commit the real .env.
#
# NOTE: the original repository committed a live .env containing a database
# password and NEXTAUTH_SECRET. Both are in git history and must be rotated.

# PostgreSQL connection string.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hospital_management_system"

# Signing key for session JWTs. Generate with: openssl rand -base64 32
# The application refuses to start in production if this is unset.
NEXTAUTH_SECRET=""

# Public origin of the deployment, used for OAuth callbacks and redirects.
NEXTAUTH_URL="http://localhost:3000"

# Optional: password for the seeded administrator account (see prisma/seed.ts).
# If unset, `npm run db:seed` prints a generated password once and does not store it.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""

# Directory for locally stored patient attachments (lib/storage.ts). Must be a
# persistent volume in production — a single-instance filesystem path does not
# survive redeploys on most PaaS platforms and does not work at all across
# multiple instances. Swap lib/storage.ts for S3/R2/GCS-backed storage before
# deploying with more than one instance.
UPLOAD_DIR="./uploads"

# Optional. Enables real card payments on invoices via Stripe Checkout. If
# either is unset, the "Pay online" button is hidden and invoices can only be
# marked paid by staff recording a payment manually — see
# Known limitations in README.md.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
