    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^3.0.2",
    "next": "15.5.2",
    "next-auth": "^4.24.11",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "recharts": "^3.2.1",
    "stripe": "^22.6.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "24.3.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "9.35.0",
    "eslint-config-next": "15.5.2",
    "prettier": "^3.6.2",
    "prisma": "^6.15.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "5.9.2",
    "vite-tsconfig-paths": "^6.1.1",
